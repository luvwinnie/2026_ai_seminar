# ============ チャット(OpenCode + OpenRouter)============
# OpenRouter API キー(https://openrouter.ai/keys で取得)
# チャットは OpenCode サーバー経由で OpenRouter のモデルを呼び出す。
OPENROUTER_API_KEY=

# チャットに使うモデル(OpenRouter のモデルID。省略時 anthropic/claude-sonnet-4.5)
OPENCODE_MODEL=anthropic/claude-sonnet-4.5

# ============ Claude API(任意・帳票AI抽出/4M分析の代替経路)============
# https://console.anthropic.com/ で取得。
# 通常は不要(抽出・4M分析も OpenCode/OpenRouter 経由で動く)。
# OPENCODE_URL 未設定環境での抽出/4M の代替としてのみ使われる(チャットは OpenCode 専用)。
ANTHROPIC_API_KEY=

# 使用モデル(省略時 claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# 報告書トリアージ(判断モデル Jev + LangGraph、docs/11)。1 で有効。Jev は上の OPENROUTER_API_KEY で呼ぶ
JEV_ENABLED=0
# 任意: TypeSafe から直接呼ぶときのキー(あれば優先)とモデル
# TYPESAFE_API_KEY=
# DECISION_MODEL=typesafe/jev-1.13
