{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:26b",
  "small_model": "ollama/gemma4:26b",
  "autoupdate": false,
  "share": "disabled",
  "disabled_providers": ["opencode"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama（ローカル LLM）",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}/v1"
      },
      "models": {
        "gemma4:26b": {
          "name": "gemma4:26b",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 131072, "output": 8000 }
        }
      }
    }
  },
  "mcp": {
    "defect-reports": {
      "type": "remote",
      "url": "{env:DEFECT_REPORTS_MCP_URL}",
      "enabled": true
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny"
  }
}
