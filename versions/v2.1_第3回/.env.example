# .env に写して使う（.env は git に入れない）。キーなどの秘密の値は .env にだけ書き、コードやログに出さない。
# 第3回はローカル LLM（Ollama）を使うので、値の要るキーは無い。

# LLM（Compose の backend と opencode が読む）
OPENCODE_MODEL=ollama/gemma4:26b
OLLAMA_BASE_URL=http://host.docker.internal:11435

# Langfuse（第3回では送らない。後の回）
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
